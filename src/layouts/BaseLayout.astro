---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

const {
  title = "lunaaastudio",
  description = "Designer working across Games, AI & Human Experience."
} = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <div class="cursor-ring" aria-hidden="true"></div>
    <Header />
    <slot />
    <Footer />
    <script is:inline>
      const I18N = {
        en: {
          "nav.work": "Work", "nav.lab": "AI Lab", "nav.library": "Library", "nav.skills": "Skills", "nav.about": "About",
          "hero.eyebrow": "LUNA CHEN — GAME UX & AI PRODUCT DESIGNER",
          "hero.title": "Designer working across Games, AI & Human Experience.",
          "hero.lede": "I design interactive experiences at the intersection of technology, play, and human behavior.",
          "hero.explore": "<span></span> EXPLORE MY WORK →",
          "hero.captionLeft": "Games · AI · Design · A more human future.",
          "hero.captionRight": "PLAY · THINK · CREATE",
          "sec.work": "SELECTED WORK", "sec.lab": "AI LAB", "sec.library": "LIBRARY", "sec.skills": "SKILLS",
          "sec.viewAll": "VIEW ALL →",
          "work.wuthering.role": "Game UX Design", "work.wuthering.meta": "2026",
          "work.goobo.role": "AI Smart Hardware · UX Design", "work.goobo.meta": "2026",
          "work.shelter.role": "Narrative 2D Platformer", "work.shelter.meta": "Steam · 2025",
          "work.office.role": "Environment Art", "work.office.meta": "UE5 · 2024",
          "work.wuthering.title": "Wuthering Waves",
          "work.goobo.title": "Goobo — AI Ita Bag",
          "work.shelter.title": "The Little Shelter",
          "work.office.title": "Abandon Office",
          "book.flow.title": "Flow",
          "book.playful.title": "A Playful Production Process",
          "book.atomic.title": "Atomic Design",
          "lab.1.title": "AI NPC Memory", "lab.2.title": "Generative Interfaces", "lab.3.title": "Game Prototypes",
          "lab.role": "Experiment", "lab.upcoming": "UPCOMING",
          "tag.all": "All", "tag.psychology": "Psychology", "tag.gamesProduction": "Games / Production", "tag.designSystems": "Design Systems",
          "skill.ux": "UX Design", "skill.game": "Game Design", "skill.3d": "3D Modeling", "skill.ai": "AI Design", "skill.motion": "Motion Design",
          "book.flow.bio": "The psychology classic on optimal experience — how deep, absorbed focus turns work and play into happiness.",
          "book.playful.bio": "Uncharted's lead designer on how great games get made — a playful, playtest-driven process from first idea to launch, no crunch required.",
          "book.atomic.bio": "The book that named design systems — atoms, molecules, organisms, and a shared language for building interfaces.",
          "about.eyebrow": "ABOUT",
          "about.title": "Designer, artist, and creative technologist exploring games, AI, and human experience.",
          "about.p1": "I'm Luna Chen, a designer working across games, AI, and interactive experiences — from game UX and AI hardware to narrative games and 3D environment art.",
          "about.p2": "I care about how technology feels: playful, clear, and human. Right now I'm exploring how AI changes the way we design, build, and play.",
          "about.capabilities": "Capabilities",
          "about.contact": "Contact"
        },
        zh: {
          "nav.work": "作品", "nav.lab": "AI 实验室", "nav.library": "书架", "nav.skills": "技能", "nav.about": "关于",
          "hero.eyebrow": "LUNA CHEN — 游戏 UX · AI 产品设计师",
          "hero.title": "横跨游戏、AI 与用户体验的设计师",
          "hero.lede": "我专注于交互体验设计，在技术、玩乐与人类行为的交汇处寻找答案。",
          "hero.explore": "<span></span> 查看我的作品 →",
          "hero.captionLeft": "游戏 · AI · 设计 · 更有人性的未来",
          "hero.captionRight": "玩乐 · 思考 · 创造",
          "sec.work": "精选作品", "sec.lab": "AI 实验室", "sec.library": "书架", "sec.skills": "专业技能",
          "sec.viewAll": "查看全部 →",
          "work.wuthering.role": "游戏 UX 设计", "work.wuthering.meta": "2026",
          "work.goobo.role": "AI 智能硬件 · UX 设计", "work.goobo.meta": "2026",
          "work.shelter.role": "叙事 2D 平台跳跃", "work.shelter.meta": "Steam · 2025",
          "work.office.role": "环境美术", "work.office.meta": "UE5 · 2024",
          "work.wuthering.title": "鸣潮",
          "work.goobo.title": "Goobo 智能娃包",
          "work.shelter.title": "小小庇护所",
          "work.office.title": "废弃办公室",
          "book.flow.title": "心流",
          "book.playful.title": "妙趣横生的游戏制作之旅",
          "book.atomic.title": "原子设计",
          "lab.1.title": "AI NPC 记忆", "lab.2.title": "生成式界面", "lab.3.title": "游戏原型",
          "lab.role": "实验", "lab.upcoming": "即将上线",
          "tag.all": "全部", "tag.psychology": "心理学", "tag.gamesProduction": "游戏 / 制作", "tag.designSystems": "设计系统",
          "skill.ux": "UX 设计", "skill.game": "游戏设计", "skill.3d": "3D 建模", "skill.ai": "AI 设计", "skill.motion": "动效设计",
          "book.flow.bio": "心理学经典之作：全然投入的「心流」状态，如何让工作与生活都成为幸福的体验。",
          "book.playful.bio": "《神秘海域》主设计师的游戏开发方法论——以试玩为核心，从创意到上线，做出好游戏不必靠赶工。",
          "book.atomic.bio": "设计系统的奠基之作——原子、分子、有机体，一套构建界面的通用语言。",
          "about.eyebrow": "关于",
          "about.title": "设计师、艺术家、创意技术人——持续探索游戏、AI 与人类体验。",
          "about.p1": "我是 Luna Chen，一名横跨游戏、AI 与交互体验的设计师——作品涵盖游戏 UX、AI 智能硬件、叙事游戏与 3D 环境美术。",
          "about.p2": "我在意技术给人的感受：好玩、清晰、有人味。目前正在探索 AI 如何改变我们设计、创造与游玩的方式。",
          "about.capabilities": "技能栈",
          "about.contact": "联系我"
        }
      };

      function applyLang(lang) {
        document.querySelectorAll("[data-i18n]").forEach((el) => {
          const v = I18N[lang][el.dataset.i18n];
          if (v != null) el.textContent = v;
        });
        document.querySelectorAll("[data-i18n-html]").forEach((el) => {
          const v = I18N[lang][el.dataset.i18nHtml];
          if (v != null) el.innerHTML = v;
        });
        document.querySelectorAll("[data-i18n-attr-title]").forEach((el) => {
          const v = I18N[lang][el.dataset.i18nAttrTitle];
          if (v != null) el.setAttribute("data-title", v);
        });
        document.documentElement.lang = lang === "zh" ? "zh-CN" : "en";
        const t = document.getElementById("langToggle");
        if (t) t.textContent = lang === "zh" ? "EN" : "中文";
        try { localStorage.setItem("lang", lang); } catch (e) {}
      }

      let initial = "en";
      try {
        initial = localStorage.getItem("lang") ||
          (navigator.language && navigator.language.toLowerCase().startsWith("zh") ? "zh" : "en");
      } catch (e) {}
      applyLang(initial);

      document.getElementById("langToggle").addEventListener("click", () => {
        applyLang(document.documentElement.lang === "zh-CN" ? "en" : "zh");
      });

      /* scroll reveal */
      (function () {
        if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) return;
        const targets = document.querySelectorAll(".section-head, .card-grid, .library-filters, .skill-list");
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (entry.isIntersecting) {
              entry.target.classList.add("is-visible");
              io.unobserve(entry.target);
            }
          });
        }, { threshold: 0.08 });
        targets.forEach((el) => { el.classList.add("reveal"); io.observe(el); });
      })();

      /* custom cursor: gradient blue circle */
      (function () {
        const ring = document.querySelector(".cursor-ring");
        if (!ring || !window.matchMedia("(hover:hover) and (pointer:fine)").matches) return;
        let x = innerWidth / 2, y = innerHeight / 2, tx = x, ty = y, shown = false;
        addEventListener("mousemove", (e) => {
          tx = e.clientX; ty = e.clientY;
          if (!shown) { shown = true; ring.classList.add("is-visible"); x = tx; y = ty; }
        });
        addEventListener("mouseleave", () => ring.classList.remove("is-visible"));
        addEventListener("mouseenter", () => { if (shown) ring.classList.add("is-visible"); });
        (function loop() {
          x += (tx - x) * 0.18; y += (ty - y) * 0.18;
          ring.style.transform = "translate(" + x + "px," + y + "px) translate(-50%,-50%)";
          requestAnimationFrame(loop);
        })();
        document.querySelectorAll("a, button").forEach((el) => {
          el.addEventListener("mouseenter", () => ring.classList.add("is-hover"));
          el.addEventListener("mouseleave", () => ring.classList.remove("is-hover"));
        });
      })();
    </script>
  </body>
</html>
