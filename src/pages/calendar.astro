---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Calendar — Luna Chen">
  <main class="shell">
    <section class="calendar-page">
      <p class="eyebrow" data-i18n="cal.eyebrow">CALENDAR</p>
      <h1 data-i18n="cal.title">Events, talks & conferences I'm attending.</h1>
      <p class="cal-lede" data-i18n="cal.lede">A running log of where I've been and where I'm heading next.</p>

      <div class="cal-list">

        <!-- Upcoming -->
        <article class="cal-item is-upcoming">
          <div class="cal-date">
            <span class="cal-month" data-i18n="cal.ufest.month">OCT</span>
            <span class="cal-day">22–23</span>
            <span class="cal-year">2026</span>
          </div>
          <div class="cal-body">
            <div class="cal-top">
              <h2 class="cal-name" data-i18n="cal.ufest.name">Unreal Fest Shanghai</h2>
              <span class="cal-badge" data-i18n="cal.upcoming">UPCOMING</span>
            </div>
            <p class="cal-place" data-i18n="cal.ufest.place">Shanghai Tower · Shanghai, China</p>
            <p class="cal-desc" data-i18n="cal.ufest.desc">Epic Games' flagship Unreal Engine community event — sessions, tech deep-dives, and the latest on UE across games, film & real-time.</p>
          </div>
        </article>

        <!-- Attended -->
        <article class="cal-item">
          <div class="cal-date">
            <span class="cal-month" data-i18n="cal.apsara.month">SEP</span>
            <span class="cal-day">22–24</span>
            <span class="cal-year">2026</span>
          </div>
          <div class="cal-body">
            <div class="cal-top">
              <h2 class="cal-name" data-i18n="cal.apsara.name">Apsara Conference (阿里云栖大会)</h2>
              <span class="cal-badge is-done" data-i18n="cal.attended">ATTENDED</span>
            </div>
            <p class="cal-place" data-i18n="cal.apsara.place">Hangzhou International Expo Center · Hangzhou, China</p>
            <p class="cal-desc" data-i18n="cal.apsara.desc">Alibaba Cloud's annual AI & cloud summit — theme "Intelligence Goes Beyond", Agent Native experience, 120+ sessions across AI, compute & digital industry.</p>
          </div>
        </article>

        <article class="cal-item">
          <div class="cal-date">
            <span class="cal-month" data-i18n="cal.waic.month">JUL</span>
            <span class="cal-day">17–20</span>
            <span class="cal-year">2026</span>
          </div>
          <div class="cal-body">
            <div class="cal-top">
              <h2 class="cal-name" data-i18n="cal.waic.name">WAIC — World Artificial Intelligence Conference</h2>
              <span class="cal-badge is-done" data-i18n="cal.attended">ATTENDED</span>
            </div>
            <p class="cal-place" data-i18n="cal.waic.place">Expo / Zhangjiang / West Bund · Shanghai, China</p>
            <p class="cal-desc" data-i18n="cal.waic.desc">The global AI summit — theme "Intelligent Companions, Creating the Future Together", four days across three venues, 150+ forums and a world-class exhibition.</p>
          </div>
        </article>

      </div>
    </section>
  </main>
</BaseLayout>
