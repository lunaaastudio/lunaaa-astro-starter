---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Calendar — Luna Chen">
  <main class="shell">
    <section class="calendar-page">
      <p class="eyebrow" data-i18n="cal.eyebrow">CALENDAR</p>
      <h1 data-i18n="cal.title">Events, talks & conferences I'm attending.</h1>
      <p class="cal-lede" data-i18n="cal.lede">A running log of where I've been and where I'm heading next.</p>

      <div class="cal-list">

        <!-- Upcoming -->
        <article class="cal-item is-upcoming">
          <a class="cal-thumb" href="https://www.unrealengine.com/unreal-fest" target="_blank" rel="noopener">
            <img src="/calendar/calendar-unreal-fest.jpg" alt="Unreal Fest Shanghai" loading="lazy" />
          </a>
          <div class="cal-body">
            <div class="cal-top">
              <span class="cal-when">
                <span class="cal-month" data-i18n="cal.ufest.month">OCT</span>
                <span class="cal-day">22–23</span>
                <span class="cal-year">2026</span>
              </span>
              <span class="cal-badge" data-i18n="cal.upcoming">UPCOMING</span>
            </div>
            <h2 class="cal-name" data-i18n="cal.ufest.name">Unreal Fest Shanghai</h2>
            <p class="cal-place" data-i18n="cal.ufest.place">Shanghai Tower · Shanghai, China</p>
            <p class="cal-desc" data-i18n="cal.ufest.desc">Epic Games' flagship Unreal Engine community event — sessions, tech deep-dives, and the latest on UE across games, film & real-time.</p>
            <a class="cal-visit" href="https://www.unrealengine.com/unreal-fest" target="_blank" rel="noopener" data-i18n="cal.visit">Official site ↗</a>
          </div>
        </article>

        <article class="cal-item is-upcoming">
          <a class="cal-thumb" href="https://awscommunity.cn/" target="_blank" rel="noopener">
            <img src="/calendar/calendar-aws-day.jpg" alt="AWS User Group Community Day" loading="lazy" />
          </a>
          <div class="cal-body">
            <div class="cal-top">
              <span class="cal-when">
                <span class="cal-month" data-i18n="cal.aws.month">OCT</span>
                <span class="cal-day">17</span>
                <span class="cal-year">2026</span>
              </span>
              <span class="cal-badge" data-i18n="cal.upcoming">UPCOMING</span>
            </div>
            <h2 class="cal-name" data-i18n="cal.aws.name">AWS User Group Community Day</h2>
            <p class="cal-place" data-i18n="cal.aws.place">Shenzhen · Guangdong, China</p>
            <p class="cal-desc" data-i18n="cal.aws.desc">A community-led conference by the AWS User Group — technical talks, hands-on workshops and peer-to-peer learning across cloud, AI/ML & architecture.</p>
            <a class="cal-visit" href="https://awscommunity.cn/" target="_blank" rel="noopener" data-i18n="cal.visit">Official site ↗</a>
          </div>
        </article>

        <!-- Attended -->
        <article class="cal-item">
          <a class="cal-thumb" href="https://yunqi.aliyun.com/" target="_blank" rel="noopener">
            <img src="/calendar/calendar-yunqi.jpg?v=2" alt="Apsara Conference" loading="lazy" />
          </a>
          <div class="cal-body">
            <div class="cal-top">
              <span class="cal-when">
                <span class="cal-month" data-i18n="cal.apsara.month">SEP</span>
                <span class="cal-day">22–24</span>
                <span class="cal-year">2026</span>
              </span>
              <span class="cal-badge is-done" data-i18n="cal.attended">ATTENDED</span>
            </div>
            <h2 class="cal-name" data-i18n="cal.apsara.name">Apsara Conference (阿里云栖大会)</h2>
            <p class="cal-place" data-i18n="cal.apsara.place">Hangzhou International Expo Center · Hangzhou, China</p>
            <p class="cal-desc" data-i18n="cal.apsara.desc">Alibaba Cloud's annual AI & cloud summit — theme "Intelligence Goes Beyond", Agent Native experience, 120+ sessions across AI, compute & digital industry.</p>
            <a class="cal-visit" href="https://yunqi.aliyun.com/" target="_blank" rel="noopener" data-i18n="cal.visit">Official site ↗</a>
          </div>
        </article>

        <article class="cal-item">
          <a class="cal-thumb" href="https://worldaic.com.cn/" target="_blank" rel="noopener">
            <img src="/calendar/calendar-waic.jpg?v=2" alt="WAIC" loading="lazy" />
          </a>
          <div class="cal-body">
            <div class="cal-top">
              <span class="cal-when">
                <span class="cal-month" data-i18n="cal.waic.month">JUL</span>
                <span class="cal-day">17–20</span>
                <span class="cal-year">2026</span>
              </span>
              <span class="cal-badge is-done" data-i18n="cal.attended">ATTENDED</span>
            </div>
            <h2 class="cal-name" data-i18n="cal.waic.name">WAIC — World Artificial Intelligence Conference</h2>
            <p class="cal-place" data-i18n="cal.waic.place">Expo / Zhangjiang / West Bund · Shanghai, China</p>
            <p class="cal-desc" data-i18n="cal.waic.desc">The global AI summit — theme "Intelligent Companions, Creating the Future Together", four days across three venues, 150+ forums and a world-class exhibition.</p>
            <a class="cal-visit" href="https://worldaic.com.cn/" target="_blank" rel="noopener" data-i18n="cal.visit">Official site ↗</a>
          </div>
        </article>

      </div>
    </section>
  </main>
</BaseLayout>
