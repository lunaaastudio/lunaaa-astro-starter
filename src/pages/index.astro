---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="shell">
    <section class="hero hero-full" style="background-image:url('/hero-art.jpg')">
      <div class="hero-inner">
        <div class="hero-copy">
          <p class="eyebrow">LUNA CHEN · 2026</p>
          <h1 data-i18n="hero.title">Designer working across Games, AI & Human Experience.</h1>
          <p class="lede" data-i18n="hero.lede">
            I design interactive experiences at the intersection of
            technology, play, and human behavior.
          </p>
          <a class="text-link" href="#work" data-i18n-html="hero.explore"><span></span> EXPLORE MY WORK →</a>
        </div>
      </div>
      <div class="art-caption left" data-i18n-html="hero.captionLeft">Games · AI · Design · A more human future.</div>
      <div class="art-caption right" data-i18n-html="hero.captionRight">PLAY · THINK · CREATE</div>
    </section>

    <section id="work" class="section-block">
      <div class="section-head">
        <h2><span>01</span><span data-i18n="sec.work">SELECTED WORK</span></h2>
      </div>

      <div class="card-grid">
        <article class="work-card">
          <a href="https://wutheringwaves.kurogames.com/" target="_blank" rel="noopener">
            <div class="thumb scene-a" data-title="Wuthering Waves" data-i18n-attr-title="work.wuthering.title" style="background-image:url('/wuthering-waves.jpg')"></div>
            <div class="card-line"><span>01</span><h3 data-i18n="work.wuthering.title">Wuthering Waves</h3><span>→</span></div>
            <p data-i18n="work.wuthering.sub">Game UX · Interaction Design · 2026</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://goobo.ai/" target="_blank" rel="noopener">
            <div class="thumb scene-goobo" data-title="Goobo — AI Ita Bag" data-i18n-attr-title="work.goobo.title" style="background-image:url('/goobo.jpg')"></div>
            <div class="card-line"><span>02</span><h3 data-i18n="work.goobo.title">Goobo — AI Ita Bag</h3><span>→</span></div>
            <p data-i18n="work.goobo.sub">AI PM · UX Design · 2026</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://store.steampowered.com/app/3583320/The_Little_Shelter/" target="_blank" rel="noopener">
            <div class="thumb scene-shelter" data-title="The Little Shelter" data-i18n-attr-title="work.shelter.title" style="background-image:url('/the-little-shelter.jpg')"></div>
            <div class="card-line"><span>03</span><h3 data-i18n="work.shelter.title">The Little Shelter</h3><span>→</span></div>
            <p data-i18n="work.shelter.sub">Narrative 2D Platformer · Steam · 2025</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.artstation.com/artwork/YB1dGb" target="_blank" rel="noopener">
            <div class="thumb scene-c" data-title="Abandon Office" data-i18n-attr-title="work.office.title" style="background-image:url('/abandon-office.jpg')"></div>
            <div class="card-line"><span>04</span><h3 data-i18n="work.office.title">Abandon Office</h3><span>→</span></div>
            <p data-i18n="work.office.sub">Environment Art · UE5 · 2024</p>
          </a>
        </article>
      </div>
    </section>

    <section id="lab" class="section-block">
      <div class="section-head">
        <h2><span>02</span><span data-i18n="sec.lab">AI LAB</span></h2>
      </div>

      <div class="card-grid">
        <article class="work-card">
          <div class="thumb lab-a"></div>
          <div class="card-line"><h3 data-i18n="lab.1.title">AI NPC Memory</h3><span>→</span></div>
          <p data-i18n="lab.sub">EXPERIMENT · 2026</p>
        </article>

        <article class="work-card">
          <div class="thumb lab-b"></div>
          <div class="card-line"><h3 data-i18n="lab.2.title">Generative Interfaces</h3><span>→</span></div>
          <p data-i18n="lab.sub">EXPERIMENT · 2026</p>
        </article>

        <article class="work-card">
          <div class="thumb lab-c"></div>
          <div class="card-line"><h3 data-i18n="lab.3.title">Game Prototypes</h3><span>→</span></div>
          <p data-i18n="lab.sub">EXPERIMENT · 2026</p>
        </article>
      </div>
    </section>

    <section id="library" class="section-block">
      <div class="section-head">
        <h2><span>03</span><span data-i18n="sec.library">LIBRARY</span></h2>
      </div>

      <div class="library-filters" role="group" aria-label="Filter books by tag">
        <button class="filter-btn is-active" data-filter="all" data-i18n="tag.all">All</button>
        <button class="filter-btn" data-filter="psychology" data-i18n="tag.psychology">Psychology</button>
        <button class="filter-btn" data-filter="games-production" data-i18n="tag.gamesProduction">Games / Production</button>
        <button class="filter-btn" data-filter="design-systems" data-i18n="tag.designSystems">Design Systems</button>
      </div>

      <div class="card-grid">
        <article class="work-card" data-tag="psychology">
          <a href="https://www.amazon.com/dp/0061339202" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="Flow" data-i18n-attr-title="book.flow.title" style="background-image:url('/library-flow.jpg')"></div>
            <div class="card-line"><span>01</span><h3 data-i18n="book.flow.title">Flow</h3><span>→</span></div>
            <p>Mihaly Csikszentmihalyi <span class="tag" data-i18n="tag.psychology">Psychology</span></p>
            <p class="bio" data-i18n="book.flow.bio">The psychology classic on optimal experience — how deep, absorbed focus turns work and play into happiness.</p>
          </a>
        </article>

        <article class="work-card" data-tag="games-production">
          <a href="https://www.playfulproductionprocess.com/" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="A Playful Production Process" data-i18n-attr-title="book.playful.title" style="background-image:url('/library-playful-production.jpg')"></div>
            <div class="card-line"><span>02</span><h3 data-i18n="book.playful.title">A Playful Production Process</h3><span>→</span></div>
            <p>Richard Lemarchand <span class="tag" data-i18n="tag.gamesProduction">Games / Production</span></p>
            <p class="bio" data-i18n="book.playful.bio">Uncharted's lead designer on how great games get made — a playful, playtest-driven process from first idea to launch, no crunch required.</p>
          </a>
        </article>

        <article class="work-card" data-tag="design-systems">
          <a href="https://atomicdesign.bradfrost.com/" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="Atomic Design" data-i18n-attr-title="book.atomic.title" style="background-image:url('/library-atomic-design.jpg')"></div>
            <div class="card-line"><span>03</span><h3 data-i18n="book.atomic.title">Atomic Design</h3><span>→</span></div>
            <p>Brad Frost <span class="tag" data-i18n="tag.designSystems">Design Systems</span></p>
            <p class="bio" data-i18n="book.atomic.bio">The book that named design systems — atoms, molecules, organisms, and a shared language for building interfaces.</p>
          </a>
        </article>
      </div>

      <script>
        const filterBtns = document.querySelectorAll(".filter-btn");
        const bookCards = document.querySelectorAll("#library .work-card");
        filterBtns.forEach((btn) =>
          btn.addEventListener("click", () => {
            filterBtns.forEach((b) => b.classList.toggle("is-active", b === btn));
            const f = btn.dataset.filter;
            bookCards.forEach((card) =>
              card.classList.toggle("is-hidden", f !== "all" && card.dataset.tag !== f)
            );
          })
        );
      </script>
    </section>

    <section id="skills" class="section-block">
      <div class="section-head">
        <h2><span>04</span><span data-i18n="sec.skills">SKILLS</span></h2>
      </div>

      <div class="skill-list">
        <div class="skill-card">
          <h3 class="skill-name" data-i18n="skill.ux">UX Design</h3>
          <p class="skill-tools">Figma · Sketch · ProtoPie</p>
        </div>
        <div class="skill-card">
          <h3 class="skill-name" data-i18n="skill.game">Game Design</h3>
          <p class="skill-tools">Unity · Unreal Engine</p>
        </div>
        <div class="skill-card">
          <h3 class="skill-name" data-i18n="skill.3d">3D Modeling</h3>
          <p class="skill-tools">Blender · Cinema 4D</p>
        </div>
        <div class="skill-card">
          <h3 class="skill-name" data-i18n="skill.ai">AI Design</h3>
          <p class="skill-tools">ChatGPT · Midjourney · ComfyUI</p>
        </div>
        <div class="skill-card">
          <h3 class="skill-name" data-i18n="skill.motion">Motion Design</h3>
          <p class="skill-tools">After Effects · Lottie</p>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>
