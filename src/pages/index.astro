---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout>
  <main class="shell">
    <section class="hero">
      <div class="hero-copy">
        <p class="eyebrow">LUNA CHEN · 2026</p>
        <h1>Designer working across Games, AI & Human Experience.</h1>
        <p class="lede">
          I design interactive experiences at the intersection of
          technology, play, and human behavior.
        </p>
        <a class="text-link" href="#work"><span></span> EXPLORE MY WORK →</a>
      </div>

      <div class="hero-art art-panel">
        <div class="moon"></div>
        <div class="silhouette"></div>
        <div class="art-caption left">Games<br>AI<br>Design<br>A more human future.</div>
        <div class="art-caption right">PLAY<br>THINK<br>CREATE</div>
      </div>
    </section>

    <section id="work" class="section-block">
      <div class="section-head">
        <div><span>01</span><span>SELECTED WORK</span></div>
        <a href="#">VIEW ALL →</a>
      </div>

      <div class="card-grid">
        <article class="work-card">
          <a href="https://wutheringwaves.kurogames.com/" target="_blank" rel="noopener">
            <div class="thumb scene-a" data-title="Wuthering Waves" style="background-image:url('/wuthering-waves.jpg')"></div>
            <div class="card-line"><span>01</span><h2>Wuthering Waves</h2><span>→</span></div>
            <p>Game UX · Interaction Design · 2026</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://store.steampowered.com/app/3583320/The_Little_Shelter/" target="_blank" rel="noopener">
            <div class="thumb scene-shelter" data-title="The Little Shelter" style="background-image:url('/the-little-shelter.jpg')"></div>
            <div class="card-line"><span>02</span><h2>The Little Shelter</h2><span>→</span></div>
            <p>Narrative 2D Platformer · Steam · 2025</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.artstation.com/artwork/YB1dGb" target="_blank" rel="noopener">
            <div class="thumb scene-c" data-title="Abandon Office" style="background-image:url('/abandon-office.jpg')"></div>
            <div class="card-line"><span>03</span><h2>Abandon Office</h2><span>→</span></div>
            <p>Environment Art · UE5 · 2024</p>
          </a>
        </article>
      </div>
    </section>

    <section id="writing" class="section-block">
      <div class="section-head">
        <div><span>02</span><span>WRITING</span></div>
        <a href="#">VIEW ALL →</a>
      </div>

      <div class="writing-list">
        <a href="#"><span>SEP 08, 2026</span><h2>Cheap Intelligence, Expensive Taste</h2><span>AI / Design</span><b>→</b></a>
        <a href="#"><span>AUG 21, 2026</span><h2>What Happens When Game Characters Can Think?</h2><span>AI / Games</span><b>→</b></a>
        <a href="#"><span>JUL 17, 2026</span><h2>From UX to Agent Experience</h2><span>UX / AI</span><b>→</b></a>
      </div>
    </section>

    <section id="lab" class="section-block">
      <div class="section-head">
        <div><span>03</span><span>LAB</span></div>
        <a href="#">VIEW ALL →</a>
      </div>

      <div class="card-grid">
        <article class="work-card">
          <div class="thumb lab-a"></div>
          <div class="card-line"><h2>AI NPC Memory</h2><span>→</span></div>
          <p>EXPERIMENT · 2026</p>
        </article>

        <article class="work-card">
          <div class="thumb lab-b"></div>
          <div class="card-line"><h2>Generative Interfaces</h2><span>→</span></div>
          <p>EXPERIMENT · 2026</p>
        </article>

        <article class="work-card">
          <div class="thumb lab-c"></div>
          <div class="card-line"><h2>Game Prototypes</h2><span>→</span></div>
          <p>EXPERIMENT · 2026</p>
        </article>
      </div>
    </section>

    <section id="library" class="section-block">
      <div class="section-head">
        <div><span>04</span><span>LIBRARY</span></div>
        <a href="#">VIEW ALL →</a>
      </div>

      <div class="card-grid">
        <article class="work-card">
          <a href="https://www.amazon.com/dp/0061339202" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="Flow" style="background-image:url('/library-flow.jpg')"></div>
            <div class="card-line"><span>01</span><h2>Flow</h2><span>→</span></div>
            <p>Mihaly Csikszentmihalyi <span class="tag">Psychology</span></p>
            <p class="bio">The psychology classic on optimal experience — how deep, absorbed focus turns work and play into happiness.</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.playfulproductionprocess.com/" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="A Playful Production Process" style="background-image:url('/library-playful-production.jpg')"></div>
            <div class="card-line"><span>02</span><h2>A Playful Production Process</h2><span>→</span></div>
            <p>Richard Lemarchand <span class="tag">Games / Production</span></p>
            <p class="bio">An Uncharted lead designer on shipping games without crunch — a playtest-driven process from first idea to launch.</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://atomicdesign.bradfrost.com/" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="Atomic Design" style="background-image:url('/library-atomic-design.jpg')"></div>
            <div class="card-line"><span>03</span><h2>Atomic Design</h2><span>→</span></div>
            <p>Brad Frost <span class="tag">Design Systems</span></p>
            <p class="bio">The book that named design systems — atoms, molecules, organisms, and a shared language for building interfaces.</p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.goodreads.com/book/show/840.The_Design_of_Everyday_Things" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="The Design of Everyday Things" style="background-image:url('/library-everyday-things.jpg')"></div>
            <div class="card-line"><span>04</span><h2>The Design of Everyday Things</h2><span>→</span></div>
            <p>Don Norman <span class="tag">Design</span></p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.goodreads.com/book/show/3828902-thinking-in-systems" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="Thinking in Systems" style="background-image:url('/library-thinking-in-systems.jpg')"></div>
            <div class="card-line"><span>05</span><h2>Thinking in Systems</h2><span>→</span></div>
            <p>Donella H. Meadows <span class="tag">Systems</span></p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.goodreads.com/book/show/106728.The_Timeless_Way_of_Building" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="The Timeless Way of Building" style="background-image:url('/library-timeless-way.jpg')"></div>
            <div class="card-line"><span>06</span><h2>The Timeless Way of Building</h2><span>→</span></div>
            <p>Christopher Alexander <span class="tag">Architecture</span></p>
          </a>
        </article>

        <article class="work-card">
          <a href="https://www.goodreads.com/book/show/147000.The_Laws_of_Simplicity" target="_blank" rel="noopener">
            <div class="thumb lib-cover" data-title="The Laws of Simplicity" style="background-image:url('/library-laws-of-simplicity.jpg')"></div>
            <div class="card-line"><span>07</span><h2>The Laws of Simplicity</h2><span>→</span></div>
            <p>John Maeda <span class="tag">Design</span></p>
          </a>
        </article>
      </div>
    </section>
  </main>
</BaseLayout>
