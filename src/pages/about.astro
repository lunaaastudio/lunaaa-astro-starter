---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="About — Luna Chen">
  <main class="shell">
    <section class="about-page">
      <img class="about-avatar" src="/about-avatar.jpg" alt="Luna Chen avatar" width="132" height="132" />
      <h1 class="about-name">Luna Chen</h1>
      <p class="about-role" data-i18n="about.role">Designer · Artist · Creative Technologist</p>

      <div class="about-meta">
        <span class="loc">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 21s-7-4.9-7-10.4A7 7 0 0 1 19 10.6C19 16.1 12 21 12 21z"/><circle cx="12" cy="10.5" r="2.5"/></svg>
          <span data-i18n="about.location">Guangzhou / Global</span>
        </span>
        <span class="sep"></span>
        <a href="mailto:lunachen019@gmail.com" aria-label="Email"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="m3 7 9 6 9-6"/></svg></a>
        <a href="https://www.linkedin.com/in/mingyuechen1214" target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28zM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/></svg></a>
        <a href="https://github.com/lunaaastudio" target="_blank" rel="noopener" aria-label="GitHub"><svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 0C5.37 0 0 5.37 0 12c0 5.31 3.435 9.795 8.205 11.385.6.105.825-.255.825-.57 0-.285-.015-1.23-.015-2.235-3.015.555-3.795-.735-4.035-1.41-.135-.345-.72-1.41-1.23-1.695-.42-.225-1.02-.78-.015-.795.945-.015 1.62.87 1.845 1.23 1.08 1.815 2.805 1.305 3.495.99.105-.78.42-1.305.765-1.605-2.67-.3-5.46-1.335-5.46-5.925 0-1.305.465-2.385 1.23-3.225-.12-.3-.54-1.53.12-3.18 0 0 1.005-.315 3.3 1.23.96-.27 1.98-.405 3-.405s2.04.135 3 .405c2.295-1.56 3.3-1.23 3.3-1.23.66 1.65.24 2.88.12 3.18.765.84 1.23 1.905 1.23 3.225 0 4.605-2.805 5.625-5.475 5.925.435.375.81 1.095.81 2.22 0 1.605-.015 2.895-.015 3.3 0 .315.225.69.825.57A12.02 12.02 0 0 0 24 12c0-6.63-5.37-12-12-12z"/></svg></a>
      </div>

      <p class="about-headline" data-i18n="about.headline">I work across games, AI and human experience.</p>

      <div class="about-bio">
        <p data-i18n="about.p1">My practice moves between interactive technology and visual culture — from digital art and exhibitions to game UX and AI-native experiences.</p>
        <p data-i18n="about.p2">I care about how technology feels: playful, expressive and human.</p>
      </div>

      <div class="about-tags">
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M6 11h4M8 9v4"/><path d="M15.5 12h.01M18.5 14h.01"/><path d="M17.32 5H6.68a4 4 0 0 0-3.98 3.59C2.6 9.42 2 14.46 2 16a3 3 0 0 0 3 3c1 0 1.5-.5 2-1l1.41-1.41A2 2 0 0 1 9.83 16h4.34a2 2 0 0 1 1.41.59L17 18c.5.5 1 1 2 1a3 3 0 0 0 3-3c0-1.54-.6-6.58-.7-7.41A4 4 0 0 0 17.32 5z"/></svg><span data-i18n="about.tag1">Game Design</span></span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9.94 15.5a2 2 0 0 0-1.44-1.44L2.37 12.5a.5.5 0 0 1 0-.96L8.5 9.94a2 2 0 0 0 1.44-1.44l1.56-6.13a.5.5 0 0 1 .96 0l1.56 6.13a2 2 0 0 0 1.44 1.44l6.13 1.56a.5.5 0 0 1 0 .96l-6.13 1.56a2 2 0 0 0-1.44 1.44l-1.56 6.13a.5.5 0 0 1-.96 0z"/><path d="M20 3v4M22 5h-4"/></svg><span data-i18n="about.tag2">AI &amp; Interaction</span></span>
        <span><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21.17 6.81a1 1 0 0 0-3.99-3.98L3.84 16.17a2 2 0 0 0-.5.83l-1.32 4.35a.5.5 0 0 0 .62.62l4.35-1.32a2 2 0 0 0 .83-.5z"/><path d="m15 5 4 4"/></svg><span data-i18n="about.tag3">Art &amp; Technology</span></span>
      </div>

      <div class="about-divider" role="presentation" aria-hidden="true"></div>

      <div class="about-block">
        <h2 class="about-h2" data-i18n="about.education">Education</h2>
        <ul class="about-list about-timeline">
          <li>
            <span class="tl-item" data-i18n="edu.calarts.title">California Institute of the Arts</span>
            <span class="tl-meta"><em>MFA</em> · Art & Technology</span>
          </li>
          <li>
            <span class="tl-item" data-i18n="edu.nyu.title">New York University — Tisch School of the Arts</span>
            <span class="tl-meta"><em>BFA</em> · Interactive Media Arts (ITP/IMA)</span>
          </li>
        </ul>
      </div>

      <div class="about-block">
        <h2 class="about-h2" data-i18n="about.experience">Work Experience</h2>
        <ul class="about-list about-timeline about-cards">
          <li>
            <span class="tl-item" data-i18n="exp.lunaaa.title">Lunaaa Studio</span>
            <span class="tl-meta"><em>Founder</em> · New York</span>
          </li>
          <li>
            <span class="tl-item" data-i18n="exp.kuro.title">Kuro Games</span>
            <span class="tl-meta"><em>Game UX Design</em> · Guangzhou</span>
          </li>
          <li>
            <span class="tl-item" data-i18n="exp.tencent.title">Tencent Games</span>
            <span class="tl-meta"><em>Game UX Design</em> · Shenzhen</span>
          </li>
          <li>
            <span class="tl-item" data-i18n="exp.teamlab.title">teamLab</span>
            <span class="tl-meta"><em>Public Relations Intern</em> · Shanghai</span>
          </li>
          <li>
            <span class="tl-item" data-i18n="exp.cai.title">Cai Guo-Qiang Studio</span>
            <span class="tl-meta"><em>Digital Art Assistant</em> · New York</span>
          </li>
        </ul>
      </div>

      <!-- JOURNEY MAP -->
      <div class="about-block">
        <img class="about-journey" src="/about-journey.jpg?v=1" alt="A journey across art, games and AI — places that shaped my practice: Quanzhou, Beijing, New York, Shanghai, Paris, Berlin, Los Angeles, Shenzhen, Guangzhou" loading="lazy" />
      </div>

      <div class="about-block">
        <h2 class="about-h2" data-i18n="about.practice">Creative Practice</h2>

        <div class="about-filters" id="practiceFilters">
          <button class="filter-btn is-active" data-filter="exhibitions" data-i18n="filter.exhibitions">Art Exhibitions</button>
          <button class="filter-btn" data-filter="shows" data-i18n="filter.shows">Game Shows</button>
          <button class="filter-btn" data-filter="press" data-i18n="filter.press">Press</button>
          <button class="filter-btn" data-filter="recognition" data-i18n="filter.recognition">Recognition</button>
        </div>

        <div class="about-fgroup is-active" data-section="exhibitions">
        <h3 class="about-h3" data-i18n="about.exhibitions">Selected Art Exhibitions</h3>
        <ul class="about-list about-timeline">
          <li class="is-solo">
            <span class="tl-item" data-i18n="exh.solo.2023.title">The Land of Nothingness</span>
            <span class="tl-meta"><em>2023</em> · Solo Exhibition — :iidrr Gallery, New York</span>
          </li>
          <li><span class="tl-item" data-i18n="exh.group.2025.title">Intersecting Realities</span><span class="tl-meta"><em>2025</em> · The Holy Art Gallery — Paris</span></li>
          <li><span class="tl-item" data-i18n="exh.group.2024-06.title">The Nature of Home: Taking Root in a Place</span><span class="tl-meta"><em>2024</em> · A Space Gallery — New York</span></li>
          <li><span class="tl-item" data-i18n="exh.group.2023-04.title">Useless Machines</span><span class="tl-meta"><em>2023</em> · TheBlanc Gallery — New York</span></li>
          <li><span class="tl-item" data-i18n="exh.group.2022-09.title">This Is Not a Drill</span><span class="tl-meta"><em>2022</em> · NYU Bobst Library — New York</span></li>
        </ul>
        </div>

        <div class="about-fgroup" data-section="shows">
        <h3 class="about-h3" data-i18n="about.shows">Selected Game Shows</h3>
        <ul class="about-list about-timeline">
          <li><span class="tl-item" data-i18n="evt.2025-chinajoy.title">ChinaJoy</span><span class="tl-meta"><em>2025</em> · Indie Game Section — Shanghai</span></li>
          <li><span class="tl-item" data-i18n="evt.2025-01.title">Sino-American Game Developer & Entrepreneurs Summit</span><span class="tl-meta"><em>2025</em> · Indie Game Section — Los Angeles</span></li>
          <li><span class="tl-item" data-i18n="evt.2024-12.title">Beings In Progress</span><span class="tl-meta"><em>2024</em> · UCLA Media Arts Sci-Fi Cohort Showcase — Los Angeles</span></li>
          <li><span class="tl-item" data-i18n="evt.2024-10.title">Game Show?!</span><span class="tl-meta"><em>2024</em> · Experimental Game Design — CalArts, Los Angeles</span></li>
          <li><span class="tl-item" data-i18n="evt.2024-07.title">China Cartoon Game Expo</span><span class="tl-meta"><em>2024</em> · Indie Game Section — Shanghai</span></li>
        </ul>
        </div>

        <div class="about-fgroup" data-section="press">
        <h3 class="about-h3" data-i18n="about.press">Press</h3>
        <ul class="about-list about-timeline">
          <li>
            <span class="tl-outlet">VoyageLA</span>
            <span class="tl-item" data-i18n="press.2025-04.title">Meet Mingyue Chen of Los Angeles</span>
            <span class="tl-meta"><em>2025</em></span>
          </li>
          <li>
            <span class="tl-outlet">China Daily · Gamersky · Vogue Chinese · Artron</span>
            <span class="tl-item" data-i18n="press.2024-04.title">Lunaaa.Studio: From Brooklyn to Guangzhou</span>
            <span class="tl-meta"><em>2024</em></span>
          </li>
          <li>
            <span class="tl-outlet">:IIDRR.Space</span>
            <span class="tl-item" data-i18n="press.2024-07-iidrr.title">Interview with Mingyue Luna Chen</span>
            <span class="tl-meta"><em>2024</em></span>
          </li>
          <li>
            <span class="tl-outlet">Marie Claire · Meer · NYU Tisch · ArtRabbit</span>
            <span class="tl-item" data-i18n="press.2023-08.title">The Land of Nothingness</span>
            <span class="tl-meta"><em>2023</em></span>
          </li>
        </ul>
        </div>

        <div class="about-fgroup" data-section="recognition">
        <h3 class="about-h3" data-i18n="about.recognition">Recognition</h3>
        <ul class="about-list about-timeline">
          <li>
            <span class="tl-outlet">Future Stars Magazine</span>
            <span class="tl-item" data-i18n="pub.2025-01.title">Issue 5</span>
            <span class="tl-meta"><em>2025</em> · The Holy Art Gallery</span>
          </li>
          <li>
            <span class="tl-outlet">Cumulus Detroit</span>
            <span class="tl-item" data-i18n="pub.2022-11.title">Selected Poster Presenter</span>
            <span class="tl-meta"><em>2022</em></span>
          </li>
        </ul>
        </div>
      </div>

      <div class="about-block">
        <h2 class="about-h2" data-i18n="about.now">Currently</h2>
        <p class="about-now-lede" data-i18n="about.now.lede">Exploring AI-native games, intelligent characters and new forms of human–AI interaction.</p>
        <div class="about-now">
          <a href="/#lab"><span data-i18n="now.lab">AI Lab</span><span data-i18n="now.lab.desc">Experiments & prototypes</span><span>↗</span></a>
          <a href="/#blog"><span data-i18n="now.blog">Blog</span><span data-i18n="now.blog.desc">Games, AI & interaction</span><span>↗</span></a>
          <a href="/#library"><span data-i18n="now.library">Library</span><span data-i18n="now.library.desc">What I'm reading</span><span>↗</span></a>
          <a href="/calendar"><span data-i18n="now.calendar">Calendar</span><span data-i18n="now.calendar.desc">Where I'm going</span><span>↗</span></a>
        </div>
      </div>

      <div class="about-block">
        <h2 class="about-h2" data-i18n="about.tools">Tools & Methods</h2>
        <p class="about-tools" data-i18n="about.tools.line">Figma · Unreal Engine · Unity · Adobe CC · Prototyping · AI-assisted development</p>
      </div>

      <div class="about-block">
        <h2 class="about-h2" data-i18n="about.contact">Contact</h2>
        <div class="about-contact">
          <a href="mailto:lunachen019@gmail.com">Email ↗</a>
          <a href="https://www.linkedin.com/in/mingyuechen1214" target="_blank" rel="noopener">LinkedIn ↗</a>
          <a href="https://github.com/lunaaastudio" target="_blank" rel="noopener">GitHub ↗</a>
        </div>
      </div>
    </section>
  </main>

  <script>
    const bar = document.getElementById("practiceFilters");
    if (bar) {
      const groups = document.querySelectorAll(".about-fgroup");
      bar.addEventListener("click", (e) => {
        const btn = e.target.closest(".filter-btn");
        if (!btn || !bar.contains(btn)) return;
        bar.querySelectorAll(".filter-btn").forEach((b) => b.classList.toggle("is-active", b === btn));
        const f = btn.dataset.filter;
        groups.forEach((g) => g.classList.toggle("is-active", g.dataset.section === f));
      });
    }
  </script>
</BaseLayout>
